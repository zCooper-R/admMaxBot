# Режим приложения
APP_ENV=production
MAXBOT_ENV=production
DEBUG=False
SECRET_KEY=

# Публичный домен и URL
DOMAIN=example.com
BASE_URL=https://example.com
PUBLIC_BASE_URL=https://example.com
WEBHOOK_URL=https://example.com/webhook

# Публикация Django-контейнера для nginx на этом же сервере.
# Для production рекомендуется 127.0.0.1. Значение 0.0.0.0 оставляйте только
# если приложение должно быть доступно напрямую без локального nginx.
WEB_APP_HOST=127.0.0.1
WEB_APP_PORT=8000

# Django security
ALLOWED_HOSTS=example.com,www.example.com
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
SECURITY_SSL_REDIRECT=true
SECURITY_SESSION_COOKIE_SECURE=true
SECURITY_CSRF_COOKIE_SECURE=true
SECURITY_HSTS_SECONDS=31536000
SECURITY_HSTS_INCLUDE_SUBDOMAINS=true
SECURITY_HSTS_PRELOAD=false

# База данных в Docker
POSTGRES_DB=maxbot
POSTGRES_USER=maxbot
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://maxbot:change-me@db:5432/maxbot

# MAX API и webhook
MAX_API_BASE_URL=https://platform-api.max.ru
MAX_API_TIMEOUT=20
MAX_BOT_TOKEN=
MAX_WEBHOOK_SECRET=
MAX_WEBHOOK_PATH=/webhook
MAX_BOT_ENABLED=true
MAX_DEBUG_LOGGING=false

# Шифрование секретов в БД. Сгенерируйте отдельный Fernet-ключ для production.
DATA_ENCRYPTION_KEY=
INTEGRATION_STATUS_CACHE_TTL=60
WEBHOOK_EVENT_RETENTION_DAYS=90
WEBHOOK_OPERATION_LOG_RETENTION_DAYS=90

# Celery periodic tasks
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_REFRESH_INTEGRATION_STATUS_INTERVAL_SECONDS=120
CELERY_SYNC_DAILY_STATS_INTERVAL_SECONDS=900
CELERY_CLEANUP_TECHNICAL_LOGS_INTERVAL_SECONDS=86400
DAILY_STATS_SYNC_WINDOW_DAYS=120

# Локальный ngrok допускается только для development-сценариев и не нужен в production.
NGROK_URL=
NGROK_WEBHOOK_URL=

# Логи и часовой пояс
TZ=Europe/Moscow
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=INFO
LOG_TO_FILES=true
LOG_DIR=/var/log/maxbot
LOG_ROTATION_MAX_BYTES=10485760
LOG_ROTATION_BACKUP_COUNT=10
