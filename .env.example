DEBUG=True
MAXBOT_ENV=development
SECRET_KEY=change-me
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

POSTGRES_DB=maxbot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Local development defaults to SQLite.
# Docker compose overrides DATABASE_URL to Postgres for containers.
DATABASE_URL=sqlite:///db.sqlite3

MAX_API_BASE_URL=https://platform-api.max.ru
MAX_API_TIMEOUT=20
# В production обязателен публичный HTTPS URL приложения.
PUBLIC_BASE_URL=http://127.0.0.1:8000
# В production обязателен отдельный Fernet-ключ для шифрования секретов в БД.
DATA_ENCRYPTION_KEY=
INTEGRATION_STATUS_CACHE_TTL=60

# Runtime fallback keys for webhook integration (used when DB values are empty)
MAX_BOT_TOKEN=
MAX_WEBHOOK_SECRET=
MAX_WEBHOOK_PATH=/webhooks/max/
MAX_BOT_ENABLED=true
MAX_DEBUG_LOGGING=false

# Production security toggles
SECURITY_SSL_REDIRECT=true
SECURITY_SESSION_COOKIE_SECURE=true
SECURITY_CSRF_COOKIE_SECURE=true
SECURITY_HSTS_SECONDS=31536000
SECURITY_HSTS_INCLUDE_SUBDOMAINS=true
SECURITY_HSTS_PRELOAD=false

# Logging
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=INFO
LOG_TO_FILES=false
LOG_DIR=logs
LOG_ROTATION_MAX_BYTES=10485760
LOG_ROTATION_BACKUP_COUNT=10
